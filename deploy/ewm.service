[Unit]
Description=Elliott Wave Monitor Gunicorn service
After=network.target postgresql.service

[Service]
User=ewm
Group=www-data
WorkingDirectory=/var/www/ewm
EnvironmentFile=/etc/ewm.env
RuntimeDirectory=ewm
RuntimeDirectoryMode=0755
ExecStart=/var/www/ewm/.venv/bin/gunicorn config.wsgi:application --workers 3 --threads 2 --timeout 60 --max-requests 1000 --max-requests-jitter 100 --bind unix:/run/ewm/gunicorn.sock --access-logfile - --error-logfile -
Restart=on-failure
RestartSec=3
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=full
ReadWritePaths=/var/www/ewm/media /var/www/ewm/staticfiles /run/ewm
UMask=0027

[Install]
WantedBy=multi-user.target
